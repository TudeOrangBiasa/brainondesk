{
  "name": "@inkeep/open-knowledge-office-fonts",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "System font location and vertical-metrics extraction for the Electron main processes (targeted sfnt table reads, no whole-file parsing)",
  "exports": {
    ".": {
      "@inkeep/source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
