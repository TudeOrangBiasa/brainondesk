{
  "name": "@inkeep/open-knowledge-office-parse",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "shared attachment parsing: pdf/docx/pptx/xlsx and plain-text formats to text; images flagged for multimodal input",
  "exports": {
    ".": {
      "@inkeep/source": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inkeep/open-knowledge-office-docx": "workspace:*",
    "fast-xml-parser": "~5.10.1",
    "jszip": "~3.10.1",
    "pdfjs-dist": "~6.2.108"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
