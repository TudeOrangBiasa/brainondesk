#!/usr/bin/env bash
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(packages|docs)/.*\.(ts|tsx|js|jsx|json|md)$|^(package\.json|turbo\.json|tsconfig\.json|biome\.jsonc)$|^(\.github/)?scripts/.*\.mjs$|^[^/]*\.ts$'; then
  pnpm exec lint-staged
fi

oversize="$(git diff --cached --numstat | while read -r added deleted f; do
  case "$added" in -*) continue;; esac
  case "$f" in
    *.lock|*lock.yaml|*lockb|*.min.*|*/dist/*|*/build/*|*/CHANGELOG.md|CHANGELOG.md|package-lock.json) continue;;
  esac
  bytes=$(( (added + deleted) * 100 ))
  if [ "$bytes" -gt 20000 ]; then echo "$f (~$((bytes / 4)) tokens staged)"; fi
done)"
[ -z "$oversize" ] || { echo "oversized staged diff (split first, then commit):"; echo "$oversize"; exit 1; }
